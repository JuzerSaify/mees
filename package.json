{
  "name": "mees",
  "version": "1.0.0",
  "private": true,
  "description": "A local-first, bring-your-own-key design agent for desktop.",
  "type": "module",
  "main": "./out/main/index.js",
  "author": "JuzerSaify",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JuzerSaify/mees.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "verify:ui": "npm run build && node scripts/verify-ui.mjs",
    "verify:tools": "npm run build && node scripts/verify-agent-tools-modes.mjs",
    "site:og": "node scripts/generate-site-og.mjs",
    "site:verify": "node scripts/verify-site.mjs",
    "build": "npm run typecheck && electron-vite build",
    "icon": "node scripts/generate-icon.mjs",
    "preview": "electron-vite preview"
  },
  "dependencies": {
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "electron-updater": "^6.8.11",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "build": {
    "appId": "studio.mees.desktop",
    "productName": "Mees",
    "artifactName": "Mees-Setup-${version}.${ext}",
    "asar": true,
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "JuzerSaify",
        "repo": "mees",
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "category": "Graphics",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
